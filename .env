NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# false en local ; nombre de proxies de confiance (souvent 1) derrière un reverse proxy.
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cours_alygne_auth
DB_TEST_NAME=cours_alygne_auth_test
DB_USER=allytall
DB_PASSWORD=allytall
DB_LOGGING=false
DB_SSL=false

JWT_ACCESS_SECRET=370c2a315c10ba0454fffa6fd460048fbbc6794e6f56a64659acc258254659b7
JWT_REFRESH_SECRET=22cb6c1afdf24430e8c9457cf5f93c5456a272827b0d45244c9f8e45dce29bce
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# log : les liens apparaissent dans le terminal. smtp : envoi réel.
MAIL_DRIVER=log
MAIL_FROM=Cours-Alygne <no-reply@cours-alygne.test>
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# Pratique avec Postman en développement, strictement interdit en production.
AUTH_EXPOSE_DEBUG_TOKENS=true
RATE_LIMIT_WINDOW_MS=60000
# La limite générale reste confortable pour 30 apprenants derrière le même NAT.
RATE_LIMIT_MAX=600
